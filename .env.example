# Copy to .env (docker compose reads it). Same image for every installation.
POSTGRES_DB=school_app_db
POSTGRES_USER=schoolcrm_owner
POSTGRES_PASSWORD=change-me-owner
APP_DB_USER=schoolcrm_api
APP_DB_PASSWORD=change-me-app
PG_DATA_DIR=/srv/schoolcrm/pg
BACKUP_DIR=/srv/schoolcrm/backups
BACKUP_AT=02:30
TZ=Asia/Kolkata

# school-auth (hosted by the platform): issuer of the access tokens this server accepts
AUTH_ISSUER_URL=https://auth.yourplatform.com
# Nightly directory refresh (client registered on school-auth as INTERNAL_CLIENT_ID / INTERNAL_CLIENT_SECRET)
DIRECTORY_SYNC_ENABLED=true
DIRECTORY_SYNC_CLIENT_ID=school-app-server
DIRECTORY_SYNC_CLIENT_SECRET=change-me

APP_PORT=8081
API_DOCS_ENABLED=false
