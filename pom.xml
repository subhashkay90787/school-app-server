<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>
	<groupId>com.school</groupId>
	<artifactId>school-app-server</artifactId>
	<version>0.1.0-SNAPSHOT</version>
	<name>school-app-server</name>
	<description>SchoolCRM app server: one API package per actor, multi-tenant by school_id, self-hostable</description>

	<properties>
		<java.version>21</java.version>
		<openapi-generator.version>7.27.0</openapi-generator.version>
		<springdoc.version>3.1.1</springdoc.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!--
			  One execution per actor spec (src/main/resources/openapi/<actor>.yaml, generated by tools/openapi/gen_openapi.py).
			  Each produces com.school.app.role.<actor>.api.<Tag>Api: a Spring MVC interface whose default methods
			  return 501 until the controller in com.school.app.role.<actor> overrides them. Operations carry
			  @Access(feature, anyOf) from x-access, enforced by platform-core. Models are shared in com.school.app.api.model.
			-->
			<plugin>
				<groupId>org.openapitools</groupId>
				<artifactId>openapi-generator-maven-plugin</artifactId>
				<version>${openapi-generator.version}</version>
				<configuration>
					<generatorName>spring</generatorName>
					<modelPackage>com.school.app.api.model</modelPackage>
					<generateApiTests>false</generateApiTests>
					<generateModelTests>false</generateModelTests>
					<generateApiDocumentation>false</generateApiDocumentation>
					<generateModelDocumentation>false</generateModelDocumentation>
					<supportingFilesToGenerate>ApiUtil.java</supportingFilesToGenerate>
					<configOptions>
						<interfaceOnly>true</interfaceOnly>
						<skipDefaultInterface>false</skipDefaultInterface>
						<useTags>true</useTags>
						<useSpringBoot3>true</useSpringBoot3>
						<useJakartaEe>true</useJakartaEe>
						<documentationProvider>none</documentationProvider>
						<annotationLibrary>none</annotationLibrary>
						<openApiNullable>false</openApiNullable>
						<useBeanValidation>true</useBeanValidation>
						<performBeanValidation>false</performBeanValidation>
						<requestMappingMode>api_interface</requestMappingMode>
						<dateLibrary>java8</dateLibrary>
						<hideGenerationTimestamp>true</hideGenerationTimestamp>
						<sourceFolder>src/gen/java</sourceFolder>
					</configOptions>
				</configuration>
				<executions>
					<execution>
						<id>api-common</id>
						<goals><goal>generate</goal></goals>
						<configuration>
							<inputSpec>${project.basedir}/src/main/resources/openapi/common.yaml</inputSpec>
							<apiPackage>com.school.app.role.common.api</apiPackage>
						</configuration>
					</execution>
					<execution>
						<id>api-admin</id>
						<goals><goal>generate</goal></goals>
						<configuration>
							<inputSpec>${project.basedir}/src/main/resources/openapi/admin.yaml</inputSpec>
							<apiPackage>com.school.app.role.admin.api</apiPackage>
						</configuration>
					</execution>
					<execution>
						<id>api-principal</id>
						<goals><goal>generate</goal></goals>
						<configuration>
							<inputSpec>${project.basedir}/src/main/resources/openapi/principal.yaml</inputSpec>
							<apiPackage>com.school.app.role.principal.api</apiPackage>
						</configuration>
					</execution>
					<execution>
						<id>api-schooladmin</id>
						<goals><goal>generate</goal></goals>
						<configuration>
							<inputSpec>${project.basedir}/src/main/resources/openapi/schooladmin.yaml</inputSpec>
							<apiPackage>com.school.app.role.schooladmin.api</apiPackage>
						</configuration>
					</execution>
					<execution>
						<id>api-accountant</id>
						<goals><goal>generate</goal></goals>
						<configuration>
							<inputSpec>${project.basedir}/src/main/resources/openapi/accountant.yaml</inputSpec>
							<apiPackage>com.school.app.role.accountant.api</apiPackage>
						</configuration>
					</execution>
					<execution>
						<id>api-hrmanager</id>
						<goals><goal>generate</goal></goals>
						<configuration>
							<inputSpec>${project.basedir}/src/main/resources/openapi/hrmanager.yaml</inputSpec>
							<apiPackage>com.school.app.role.hrmanager.api</apiPackage>
						</configuration>
					</execution>
					<execution>
						<id>api-admissionofficer</id>
						<goals><goal>generate</goal></goals>
						<configuration>
							<inputSpec>${project.basedir}/src/main/resources/openapi/admissionofficer.yaml</inputSpec>
							<apiPackage>com.school.app.role.admissionofficer.api</apiPackage>
						</configuration>
					</execution>
					<execution>
						<id>api-receptionist</id>
						<goals><goal>generate</goal></goals>
						<configuration>
							<inputSpec>${project.basedir}/src/main/resources/openapi/receptionist.yaml</inputSpec>
							<apiPackage>com.school.app.role.receptionist.api</apiPackage>
						</configuration>
					</execution>
					<execution>
						<id>api-teacher</id>
						<goals><goal>generate</goal></goals>
						<configuration>
							<inputSpec>${project.basedir}/src/main/resources/openapi/teacher.yaml</inputSpec>
							<apiPackage>com.school.app.role.teacher.api</apiPackage>
						</configuration>
					</execution>
					<execution>
						<id>api-parent</id>
						<goals><goal>generate</goal></goals>
						<configuration>
							<inputSpec>${project.basedir}/src/main/resources/openapi/parent.yaml</inputSpec>
							<apiPackage>com.school.app.role.parent.api</apiPackage>
						</configuration>
					</execution>
					<execution>
						<id>api-student</id>
						<goals><goal>generate</goal></goals>
						<configuration>
							<inputSpec>${project.basedir}/src/main/resources/openapi/student.yaml</inputSpec>
							<apiPackage>com.school.app.role.student.api</apiPackage>
						</configuration>
					</execution>
					<execution>
						<id>api-chiefwarden</id>
						<goals><goal>generate</goal></goals>
						<configuration>
							<inputSpec>${project.basedir}/src/main/resources/openapi/chiefwarden.yaml</inputSpec>
							<apiPackage>com.school.app.role.chiefwarden.api</apiPackage>
						</configuration>
					</execution>
					<execution>
						<id>api-warden</id>
						<goals><goal>generate</goal></goals>
						<configuration>
							<inputSpec>${project.basedir}/src/main/resources/openapi/warden.yaml</inputSpec>
							<apiPackage>com.school.app.role.warden.api</apiPackage>
						</configuration>
					</execution>
					<execution>
						<id>api-matron</id>
						<goals><goal>generate</goal></goals>
						<configuration>
							<inputSpec>${project.basedir}/src/main/resources/openapi/matron.yaml</inputSpec>
							<apiPackage>com.school.app.role.matron.api</apiPackage>
						</configuration>
					</execution>
					<execution>
						<id>api-nurse</id>
						<goals><goal>generate</goal></goals>
						<configuration>
							<inputSpec>${project.basedir}/src/main/resources/openapi/nurse.yaml</inputSpec>
							<apiPackage>com.school.app.role.nurse.api</apiPackage>
						</configuration>
					</execution>
					<execution>
						<id>api-messmanager</id>
						<goals><goal>generate</goal></goals>
						<configuration>
							<inputSpec>${project.basedir}/src/main/resources/openapi/messmanager.yaml</inputSpec>
							<apiPackage>com.school.app.role.messmanager.api</apiPackage>
						</configuration>
					</execution>
					<execution>
						<id>api-security</id>
						<goals><goal>generate</goal></goals>
						<configuration>
							<inputSpec>${project.basedir}/src/main/resources/openapi/security.yaml</inputSpec>
							<apiPackage>com.school.app.role.security.api</apiPackage>
						</configuration>
					</execution>
					<execution>
						<id>api-securitysupervisor</id>
						<goals><goal>generate</goal></goals>
						<configuration>
							<inputSpec>${project.basedir}/src/main/resources/openapi/securitysupervisor.yaml</inputSpec>
							<apiPackage>com.school.app.role.securitysupervisor.api</apiPackage>
						</configuration>
					</execution>
					<execution>
						<id>api-staff</id>
						<goals><goal>generate</goal></goals>
						<configuration>
							<inputSpec>${project.basedir}/src/main/resources/openapi/staff.yaml</inputSpec>
							<apiPackage>com.school.app.role.staff.api</apiPackage>
						</configuration>
					</execution>
					<execution>
						<id>api-storekeeper</id>
						<goals><goal>generate</goal></goals>
						<configuration>
							<inputSpec>${project.basedir}/src/main/resources/openapi/storekeeper.yaml</inputSpec>
							<apiPackage>com.school.app.role.storekeeper.api</apiPackage>
						</configuration>
					</execution>
					<execution>
						<id>api-transportmanager</id>
						<goals><goal>generate</goal></goals>
						<configuration>
							<inputSpec>${project.basedir}/src/main/resources/openapi/transportmanager.yaml</inputSpec>
							<apiPackage>com.school.app.role.transportmanager.api</apiPackage>
						</configuration>
					</execution>
					<execution>
						<id>api-driver</id>
						<goals><goal>generate</goal></goals>
						<configuration>
							<inputSpec>${project.basedir}/src/main/resources/openapi/driver.yaml</inputSpec>
							<apiPackage>com.school.app.role.driver.api</apiPackage>
						</configuration>
					</execution>
					<execution>
						<id>api-assistant</id>
						<goals><goal>generate</goal></goals>
						<configuration>
							<inputSpec>${project.basedir}/src/main/resources/openapi/assistant.yaml</inputSpec>
							<apiPackage>com.school.app.role.assistant.api</apiPackage>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
